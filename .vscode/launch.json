{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UserManagement.Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "rebuild UserManagement.Web",
      "program": "${workspaceFolder}/UserManagement.Web/bin/Debug/net9.0/UserManagement.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/UserManagement.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7084;http://localhost:5084",
        "ProxyTo": "http://localhost:62507"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    }
  ]
}